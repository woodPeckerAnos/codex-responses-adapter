# Bind address. Keep localhost unless you add authentication.
CRA_HOST=127.0.0.1
CRA_PORT=8000
CRA_LOG_LEVEL=INFO

# Codex CLI discovery. Leave empty to use the global `codex` on PATH.
CRA_CODEX_PATH=
CRA_CODEX_MODEL=
CRA_CODEX_WORKDIR=
CRA_CODEX_SANDBOX=read-only
CRA_CODEX_APPROVAL_POLICY=never
CRA_WEB_SEARCH=false
CRA_SKIP_GIT_CHECK=true

# Runtime limits.
CRA_REQUEST_TIMEOUT=300
CRA_QUEUE_TIMEOUT=30
CRA_MAX_CONCURRENCY=2

# previous_response_id storage. In-memory and per-process only.
CRA_RESPONSE_TTL=86400
CRA_MAX_RESPONSE_RECORDS=1000
CRA_STORE_BY_DEFAULT=true

# Optional static Bearer token for /v1/responses. /health stays public.
CRA_API_KEY=

# Logging. Prompt text is never logged unless CRA_LOG_PROMPTS=true.
CRA_LOG_REQUESTS=true
CRA_LOG_PROMPTS=false

# Model name reported when the request omits `model`.
# For Codex 0.166+ with GPT-6.1:
# CRA_CODEX_MODEL=gpt-6.1-sol
# CRA_DEFAULT_MODEL=gpt-6.1-sol
# CRA_MODEL_CONTEXT_WINDOW=200000
CRA_DEFAULT_MODEL=codex-cli
CRA_MODEL_DISPLAY_NAME=Codex CLI
CRA_MODEL_CONTEXT_WINDOW=128000
CRA_MODEL_MAX_OUTPUT_TOKENS=16384
# Keep below Codex's 1,048,576-character input cap; oldest middle context is dropped above it.
CRA_MAX_PROMPT_CHARS=1000000
